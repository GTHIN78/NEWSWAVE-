import React, { useState, useEffect } from 'react';
import { 
  ChevronRight, 
  ChevronLeft, 
  Pause, 
  Play, 
  Sparkles, 
  Sun, 
  Moon, 
  Video, 
  ShieldCheck, 
  Globe,
  Building2,
  Crown,
  RefreshCw
} from 'lucide-react';
import { Article, Language, UserRole } from '../types/news';
import { getFormattedHindiDate } from '../utils/newsFilters';

interface TopBarProps {
  breakingArticles: Article[];
  language: Language;
  onToggleLanguage: (lang: Language) => void;
  darkMode: boolean;
  onToggleDarkMode: () => void;
  onSelectArticle: (article: Article) => void;
  onOpenDataGuide: () => void;
  onOpenVideoNews: () => void;
  onOpenAdmin: () => void;
  onOpenSaaS?: () => void;
  onOpenPlatformAdmin?: () => void;
  activeTenantName?: string;
  currentUser?: any;
  userRole?: UserRole;
  onSignInGoogle?: () => void;
  onSignOut?: () => void;
  onRefreshNews?: () => void;
  isRefreshing?: boolean;
}

export const TopBar: React.FC<TopBarProps> = ({
  breakingArticles,
  language,
  onToggleLanguage,
  darkMode,
  onToggleDarkMode,
  onSelectArticle,
  onOpenDataGuide,
  onOpenVideoNews,
  onOpenAdmin,
  onOpenSaaS,
  onOpenPlatformAdmin,
  activeTenantName,
  currentUser,
  userRole = 'reader',
  onSignInGoogle,
  onSignOut,
  onRefreshNews,
  isRefreshing = false,
}) => {
  const [currentIndex, setCurrentIndex] = useState(0);
  const [isPlaying, setIsPlaying] = useState(true);
  const isHindi = language === 'hi';

  const hindiDate = getFormattedHindiDate();
  const englishDate = new Date().toLocaleDateString('en-IN', {
    weekday: 'long',
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

  useEffect(() => {
    if (!isPlaying || breakingArticles.length <= 1) return;
    const interval = setInterval(() => {
      setCurrentIndex((prev) => (prev + 1) % breakingArticles.length);
    }, 4500);
    return () => clearInterval(interval);
  }, [isPlaying, breakingArticles.length]);

  const currentArticle = breakingArticles[currentIndex] || breakingArticles[0];

  const handlePrev = (e: React.MouseEvent) => {
    e.stopPropagation();
    setCurrentIndex((prev) => (prev - 1 + breakingArticles.length) % breakingArticles.length);
  };

  const handleNext = (e: React.MouseEvent) => {
    e.stopPropagation();
    setCurrentIndex((prev) => (prev + 1) % breakingArticles.length);
  };

  const displayTitle = currentArticle 
    ? (isHindi ? currentArticle.title : (currentArticle.titleEn || currentArticle.title))
    : '';

  return (
    <div className="bg-[#121212] text-white text-xs border-b border-neutral-800 transition-colors">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div className="flex flex-col md:flex-row md:items-center justify-between py-1.5 gap-2">
          {/* Left: Date, Edition & Weather */}
          <div className="flex items-center gap-2.5 text-neutral-300 font-devanagari text-[11px] sm:text-xs">
            <span className="font-semibold text-white">
              {isHindi ? hindiDate : englishDate}
            </span>
            <span className="text-neutral-600 hidden sm:inline" aria-hidden="true">|</span>
            <span className="hidden sm:inline bg-neutral-800 px-2 py-0.5 rounded text-[11px] text-neutral-300">
              {isHindi ? 'राष्ट्रीय संस्करण (नई दिल्ली)' : 'National Edition (New Delhi)'}
            </span>
            <span className="text-neutral-600 hidden md:inline" aria-hidden="true">|</span>
            <span className="hidden md:inline text-neutral-400">
              28°C {isHindi ? 'नई दिल्ली' : 'New Delhi'}
            </span>
          </div>

          {/* Center/Right: Breaking News Ticker & Control Bar */}
          <div className="flex items-center gap-2 flex-1 md:justify-end overflow-hidden">
            {/* Ticker Tag */}
            <div className="flex items-center gap-1.5 bg-[#B71925] text-white px-2 py-0.5 text-[11px] font-bold uppercase tracking-wider shrink-0 rounded-xs">
              <span className="w-1.5 h-1.5 rounded-full bg-white animate-pulse" />
              <span>{isHindi ? 'ब्रेकिंग' : 'BREAKING'}</span>
            </div>

            {/* Headline Ticker Item */}
            {currentArticle && (
              <div 
                className="flex items-center gap-2 truncate cursor-pointer hover:text-red-300 transition-colors flex-1 md:flex-initial max-w-md lg:max-w-lg"
                onClick={() => onSelectArticle(currentArticle)}
                title={displayTitle}
                role="button"
                tabIndex={0}
                onKeyDown={(e) => e.key === 'Enter' && onSelectArticle(currentArticle)}
              >
                <span className="truncate text-[12px] font-devanagari text-neutral-200">
                  {displayTitle}
                </span>
                <span className="text-[11px] text-neutral-400 shrink-0 font-devanagari hidden sm:inline">
                  ({currentArticle.publishedAt})
                </span>
              </div>
            )}

            {/* Ticker Prev/Next Controls */}
            {breakingArticles.length > 1 && (
              <div className="hidden sm:flex items-center gap-0.5 shrink-0 text-neutral-400">
                <button
                  type="button"
                  onClick={handlePrev}
                  className="p-1 hover:text-white transition-colors cursor-pointer"
                  aria-label="पिछली खबर"
                >
                  <ChevronLeft className="w-3.5 h-3.5" />
                </button>
                <button
                  type="button"
                  onClick={() => setIsPlaying(!isPlaying)}
                  className="p-1 hover:text-white transition-colors cursor-pointer"
                  aria-label={isPlaying ? 'रोकें' : 'चलाएं'}
                >
                  {isPlaying ? <Pause className="w-3 h-3" /> : <Play className="w-3 h-3" />}
                </button>
                <button
                  type="button"
                  onClick={handleNext}
                  className="p-1 hover:text-white transition-colors cursor-pointer"
                  aria-label="अगली खबर"
                >
                  <ChevronRight className="w-3.5 h-3.5" />
                </button>
              </div>
            )}

            {onRefreshNews && (
              <button
                type="button"
                onClick={onRefreshNews}
                disabled={isRefreshing}
                className="hidden sm:inline-flex items-center gap-1 text-[11px] text-amber-300 hover:text-amber-200 transition-colors p-1 cursor-pointer disabled:opacity-50"
                title={isHindi ? "ताज़ा खबरें (रिफ्रेश) • नया कंटेंट" : "Refresh News Feed"}
                aria-label="Refresh Breaking News"
              >
                <RefreshCw className={`w-3 h-3 ${isRefreshing ? 'animate-spin' : ''}`} />
              </button>
            )}

            <div className="h-3 w-[1px] bg-neutral-700 hidden sm:block shrink-0 mx-1" />

            {/* Bilingual Language Switcher (Prompt Item 4) */}
            <div className="flex items-center bg-neutral-800 rounded p-0.5 shrink-0 border border-neutral-700">
              <button
                type="button"
                onClick={() => onToggleLanguage('hi')}
                className={`px-2 py-0.5 rounded text-[11px] font-bold transition-all cursor-pointer ${
                  isHindi ? 'bg-[#B71925] text-white shadow-xs' : 'text-neutral-400 hover:text-white'
                }`}
                title="हिंदी संस्करण"
              >
                हिंदी
              </button>
              <button
                type="button"
                onClick={() => onToggleLanguage('en')}
                className={`px-2 py-0.5 rounded text-[11px] font-bold transition-all cursor-pointer ${
                  !isHindi ? 'bg-[#B71925] text-white shadow-xs' : 'text-neutral-400 hover:text-white'
                }`}
                title="English Edition"
              >
                English
              </button>
            </div>

            {/* Dark Mode Toggle (Prompt Item 2) */}
            <button
              type="button"
              onClick={onToggleDarkMode}
              className="p-1.5 text-neutral-300 hover:text-white bg-neutral-800 hover:bg-neutral-700 rounded transition-colors shrink-0 cursor-pointer"
              title={darkMode ? 'लाइट मोड सक्रिय करें' : 'डार्क मोड सक्रिय करें'}
              aria-label={darkMode ? 'Switch to light mode' : 'Switch to dark mode'}
            >
              {darkMode ? <Sun className="w-3.5 h-3.5 text-amber-300" /> : <Moon className="w-3.5 h-3.5 text-neutral-300" />}
            </button>

            {/* Video News Direct Button */}
            <button
              onClick={onOpenVideoNews}
              className="hidden lg:flex items-center gap-1 text-[11px] text-red-300 hover:text-red-200 shrink-0 transition-colors ml-1 cursor-pointer"
              title="वीडियो समाचार बुलेटिन"
            >
              <Video className="w-3 h-3 text-[#B71925]" />
              <span>{isHindi ? 'वीडियो' : 'Videos'}</span>
            </button>

            {/* SaaS Publications Workspace Button */}
            {onOpenSaaS && (
              <button
                onClick={onOpenSaaS}
                className="flex items-center gap-1 text-[11px] bg-neutral-800 hover:bg-neutral-700 text-cyan-300 hover:text-cyan-200 px-2 py-0.5 rounded transition-colors cursor-pointer border border-neutral-700"
                title="SaaS पब्लिकेशन कार्यक्षेत्र (Multi-tenant Newsroom SaaS)"
              >
                <Building2 className="w-3 h-3 text-cyan-400" />
                <span>{isHindi ? 'SaaS पोर्टल' : 'SaaS'}</span>
              </button>
            )}

            {/* Platform Owner / Super Admin Button */}
            {onOpenPlatformAdmin && (currentUser?.email === 'sanjayraj505@gmail.com' || userRole === 'admin') && (
              <button
                onClick={onOpenPlatformAdmin}
                className="flex items-center gap-1 text-[11px] bg-amber-950/80 hover:bg-amber-900 text-amber-300 hover:text-amber-200 px-2 py-0.5 rounded transition-colors cursor-pointer border border-amber-600/50"
                title="सुपर एडमिन डैशबोर्ड (Platform Owner Control Room)"
              >
                <Crown className="w-3 h-3 text-amber-400" />
                <span>{isHindi ? 'सुपर एडमिन' : 'Platform Owner'}</span>
              </button>
            )}

            {/* CMS / Admin Workspace & Auth */}
            {currentUser ? (
              <div className="flex items-center gap-1.5 shrink-0">
                <button
                  onClick={onOpenAdmin}
                  className="flex items-center gap-1 text-[11px] bg-neutral-800 hover:bg-neutral-700 text-amber-300 hover:text-amber-200 px-2 py-0.5 rounded transition-colors cursor-pointer border border-neutral-700"
                  title="न्यूज़रूम सीएमएस (CMS Desk)"
                >
                  <Sparkles className="w-3 h-3 text-amber-400" />
                  <span>CMS</span>
                  <span className="text-[10px] bg-amber-400/20 text-amber-300 px-1 rounded uppercase font-semibold">
                    {userRole === 'admin' ? 'व्यवस्थापक' : userRole === 'chief_editor' ? 'प्रधान संपादक' : userRole === 'editor' ? 'संपादक' : 'स्टाफ'}
                  </span>
                </button>
                {onSignOut && (
                  <button
                    onClick={onSignOut}
                    className="text-[10px] text-neutral-400 hover:text-white px-1.5 py-0.5 rounded hover:bg-neutral-800 transition-colors cursor-pointer"
                    title="लॉगआउट"
                  >
                    {isHindi ? 'लॉगआउट' : 'Sign out'}
                  </button>
                )}
              </div>
            ) : (
              <div className="flex items-center gap-1.5 shrink-0">
                <button
                  onClick={onOpenAdmin}
                  className="flex items-center gap-1 text-[11px] bg-neutral-800 hover:bg-neutral-700 text-amber-300 hover:text-amber-200 px-2 py-0.5 rounded transition-colors cursor-pointer border border-neutral-700"
                  title="न्यूज़रूम सीएमएस (CMS Desk)"
                >
                  <Sparkles className="w-3 h-3 text-amber-400" />
                  <span>CMS</span>
                </button>
                {onSignInGoogle && (
                  <button
                    onClick={onSignInGoogle}
                    className="flex items-center gap-1 text-[11px] bg-[#B71925] hover:bg-red-800 text-white px-2 py-0.5 rounded font-medium transition-colors cursor-pointer"
                    title="संपादकीय लॉगिन (Editorial Staff Sign In)"
                  >
                    <ShieldCheck className="w-3 h-3 text-white" />
                    <span>{isHindi ? 'स्टाफ लॉगिन' : 'Staff Login'}</span>
                  </button>
                )}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
};
